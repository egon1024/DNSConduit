[Unit]
Description=DNS Conduit
Documentation=https://egon1024.github.io/DNSConduit/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=conduit
Group=conduit
ExecStart=/usr/bin/conduit /etc/conduit/conduit.yaml
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
