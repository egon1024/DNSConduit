; Harness-owned zone for authoritative peers (not copied from any peer project).
$TTL 3600
@   IN SOA ns1.example.test. hostmaster.example.test. (
        2026071402 ; serial
        3600       ; refresh
        600        ; retry
        86400      ; expire
        300 )      ; minimum
    IN NS  ns1.example.test.
ns1 IN A   192.0.2.53
www IN A   192.0.2.10
www IN AAAA 2001:db8::10
api IN A   192.0.2.11
alias IN CNAME www
; Oversized multi-A RRset for TC / truncation passthrough (Query with small EDNS bufsize).
big IN A 192.0.2.100
big IN A 192.0.2.101
big IN A 192.0.2.102
big IN A 192.0.2.103
big IN A 192.0.2.104
big IN A 192.0.2.105
big IN A 192.0.2.106
big IN A 192.0.2.107
